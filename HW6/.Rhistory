# Load necessary libraries
library(DT)          # Table display
library(lubridate)   # Date handling
library(dplyr)       # Data manipulation
library(ggplot2)     # Data visualization
library(plm)         # Panel data models
library(lmtest)      # Diagnostic tests for linear models
library(sandwich)    # Robust standard errors
library(stargazer)   # To create regression tables
library(plotly)      # Interactive visulization
library(haven)
library(tidyverse)
library(broom)
library(knitr)
# Model estimation
cig_pooled_model <- plm(
formula = ln_sales ~ ln_income + ln_price,
data = cig_data,
model = "pooling"
)
cig_fe_model <- plm(
formula = ln_sales ~ ln_income + ln_price,
data = cig_data,
model = "within"
)
cig_re_model <- plm(
formula = ln_sales ~ ln_income + ln_price,
data = cig_data,
model = "random"
)
# Compute standard errors
cig_pooled_se <- coeftest(cig_pooled_model, vcov = vcovHC(cig_pooled_model, type = "HC1", cluster = "group"))
cig_fe_se <- coeftest(cig_fe_model, vcov = vcovHC(cig_fe_model, type = "HC1", cluster = "group"))
cig_re_se <- coeftest(cig_re_model, vcov = vcovHC(cig_re_model, type = "HC1", cluster = "group"))
# Display results using stargazer
stargazer(cig_pooled_model, cig_fe_model, cig_re_model, type = "text", se = list(cig_pooled_se[, 2], cig_fe_se[, 2], cig_re_se[, 2]))
