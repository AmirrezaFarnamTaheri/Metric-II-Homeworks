# Load the dataset
cig_data <- as_tibble(read_dta("./Data/Cigar.dta"))
# Construct variables
cig_data <- cig_data %>%
mutate(
ln_sales = log(sales),
ln_income = log(income / cpi * 100),
ln_price = log(price / cpi * 100)
)
# Setup chunk to load required packages and set global options
knitr::opts_chunk$set(echo = TRUE)
knitr::opts_chunk$set(echo = TRUE)
