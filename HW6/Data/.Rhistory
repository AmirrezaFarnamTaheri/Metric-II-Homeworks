library(readxl)
library(haven)
setwd(".")
# Load the data from the Excel files
file_names <- c("Sum_R1400_New_HK.xlsx", "Sum_R1401_New_HK.xlsx", "Sum_U1400_New_HK.xlsx", "Sum_U1401_New_HK.xlsx")
for (file in file_names) {
data <- read_excel(file)
# Rename the columns
colnames(data) <- old_to_new_names[colnames(data)]
# Optionally, set descriptions as attributes (if needed)
for (name in names(data)) {
attr(data[[name]], "description") <- variable_descriptions[[name]]
}
# Print the first few rows of the renamed data to check
print(head(data))
# Save the renamed data to a Stata file
write_dta(data, paste0("renamed_", gsub(".xlsx", "", file), ".dta"))
}
