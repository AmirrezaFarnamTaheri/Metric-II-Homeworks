calculate_attrition_rates <- function(data) {
# Initialize an empty vector to store the attrition rates
attrition_rates <- c()
for (star_column in c("stark", "star1", "star2", "star3")) {
# Calculate the total number of students in the STAR program
total_students <- sum(!(is.na)(data[[star_column]]))
# Calculate the number of students who attrited
attrited_students <- sum(!(is.na)(data[[star_column]]) & ((is.na)(data$star1) | (is.na)(data$star2) | (is.na)(data$star3)))
# Calculate the attrition rate
attrition_rate <- (attrited_students / total_students) * 100
# Append the attrition rate to the vector
attrition_rates <- c(attrition_rates, attrition_rate)
}
