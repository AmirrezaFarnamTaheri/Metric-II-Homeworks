calculate_attrition_rate <- function(data, attrition_column, star_columns) {
# Initialize an empty vector to store the attrition rates
attrition_rates <- numeric(length(star_columns))
# Loop over the star columns
for (i in seq_along(star_columns)) {
# Calculate the number of attritions for the current star column
attritions <- sum(data[[attrition_column]] == i, na.rm = TRUE)
# Calculate the total number of observations for the current star column
total <- sum(!is.na(data[[star_columns[i]]]))
# Calculate the attrition rate and store it in the vector
attrition_rates[i] <- attritions / total
}
# Return the attrition rates
return(attrition_rates)
}
# Now you can calculate the attrition rate for each star column
star_columns <- c("stark", "star1", "star2", "star3")
attrition_rates <- calculate_attrition_rate(STAR, "attrition", star_columns)
