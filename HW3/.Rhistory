avg_life_span_chemo <- mean(patient_data$Y_0[patient_data$D == 0], na.rm = TRUE)
# Calculate the observed effect
observed_effect <- avg_life_span_surgery - avg_life_span_chemo
# Output the observed effect
print(observed_effect)
# Calculate the difference in lifespan for each treatment option for each patient
patient_data$diff_life_span <- patient_data$Y_1 - patient_data$Y_0
# Determine if the correct treatment was given
# If diff_life_span > 0, then surgery yields a longer lifespan and should have been the treatment
# If diff_life_span < 0, then chemotherapy yields a longer lifespan and should have been the treatment
patient_data$treatment_correct <- ifelse(patient_data$diff_life_span > 0, 1, 0)
# Compare the treatment_correct with the actual treatment given (D)
patient_data$correct_decision <- patient_data$treatment_correct == patient_data$D
# Calculate the proportion of correct decisions
proportion_correct <- mean(patient_data$correct_decision, na.rm = TRUE)
# Output the proportion of correct decisions
print(proportion_correct)
