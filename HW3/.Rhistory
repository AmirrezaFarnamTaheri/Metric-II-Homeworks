calculate_attrition_rates <- function(data) {
# Define the mapping of star columns to levels of education
level_mapping <- c("stark", "star1", "star2", "star3")
# Initialize an empty list to store the results
attrition_list <- list()
# Loop through each level except the last one (since there's no attrition for Grade 3 by definition)
for (i in 1:(length(level_mapping) - 1)) {
# Get the current and next level star columns
current_level <- level_mapping[i]
next_level <- level_mapping[i + 1]
# Calculate attrition for the current level
attrition_data <- data %>%
filter(!is.na(.[[current_level]]) & is.na(.[[next_level]])) %>%
group_by(.[[current_level]]) %>%
summarise(Attrition_Count = n(), .groups = 'drop')
# Calculate the percentage of attrition for each category within the current level
attrition_data <- attrition_data %>%
mutate(Total_Count = sum(!is.na(data[[current_level]])),
Attrition_Percentage = (Attrition_Count / Total_Count) * 100)
# Add the level name to the results
attrition_data$Level <- names(level_mapping)[i]
# Add the results to the attrition list
attrition_list[[i]] <- attrition_data
}
# Combine the results into a single data frame
attrition_df <- bind_rows(attrition_list)
# Return the attrition data frame
return(attrition_df)
}
attrition_rates <- calculate_attrition_rates(STAR)
kable(attrition_rates, align="lccccc", digits=3)
