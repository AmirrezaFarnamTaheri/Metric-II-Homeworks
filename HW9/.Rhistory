# Load the packages
library(tidyverse)
library(foreign)
library(AER)
library(DT)
library(htmltools)
library(stargazer)
library(dplyr)
setwd(".")
final5 <- as_tibble(read.dta("./Data/final5.dta"))
# Data Cleaning
final5 <- final5 %>%
rename(enroll = c_size, pdis = tipuach) %>%
filter(enroll >= 5 & enroll < 44) %>%
select(schlcode, enroll, classize, pdis, avgverb, avgmath, verbsize, mathsize)
# Correct grades higher than 100
final5$avgmath <- ifelse(final5$avgmath > 100, final5$avgmath - 100, final5$avgmath)
final5$avgverb <- ifelse(final5$avgverb > 100, final5$avgverb - 100, final5$avgverb)
# Replace zero or missing class sizes, math sizes, and verb sizes with NA
final5$classize <- ifelse(final5$classize == 0 | is.na(final5$classize), NA, final5$classize)
final5$mathsize <- ifelse(final5$mathsize == 0 | is.na(final5$mathsize), NA, final5$mathsize)
final5$verbsize <- ifelse(final5$verbsize == 0 | is.na(final5$verbsize), NA, final5$verbsize)
# Replace zero or missing class sizes with NA
final5$classize <- ifelse(final5$classize == 0, NA, final5$classize)
descriptive_stats <-  stargazer(as.data.frame(final5),
type = "html",
title = "Descriptive Statistics",
label = "tab:descriptive_stats",
digits = 2,
header = FALSE,
covariate.labels = c("School Code",
"Enrollment",
"Class Size",
"Percent Disadvantaged",
"Average Verbal Score",
"Average Math Score",
"Reading Size",
"Math Size"),
summary.stat = c("mean", "sd", "p25", "median", "p75", "min", "max"),
notes = c("Source: Angrist and Lavy (1999)"),
notes.align = "l",
align = TRUE,
font.size = "small",
initial.zero = TRUE,
style = "AER")
# Generate detailed summary statistics with enhancements
cat("<center>", descriptive_stats, "<center>")
