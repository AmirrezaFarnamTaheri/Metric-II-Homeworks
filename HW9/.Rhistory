# Create the instrumental variable
final5 <- final5 %>%
mutate(m = enroll / (floor((enroll - 1) / 40) + 1)) %>%
mutate(enoll2percent = enroll^2 / 100)
# Math Grades Estimation
# OLS estimations
ols_math1 <- lm(avgmath ~ mathsize,
na.rm = TRUE, data = final5)
ols_math2 <- lm(avgmath ~ mathsize + pdis,
na.rm = TRUE, data = final5)
ols_math3 <- lm(avgmath ~ mathsize + pdis + enroll,
na.rm = TRUE, data = final5)
# 2SLS estimations
tsls_math1 <- ivreg(avgmath ~ mathsize + pdis + enroll | m + pdis + enroll,
na.rm = TRUE, data = final5)
tsls_math2 <- ivreg(avgmath ~ mathsize + pdis + enroll + enoll2percent | m + pdis + enroll + enoll2percent,
na.rm=  TRUE, data = final5)
stargazer_math <- stargazer(ols_math1, ols_math2, ols_math3, tsls_math1, tsls_math2,
type = "html",
title = "<center> Effects of Class Size on Fifth Grade Math Scores <center>",
label = "tab:class_size_effects_math",
digits = 3,
style = "AER",
align = TRUE,
dep.var.labels = "<center>Math Scores<center>",
notes = c("Source: Angrist and Lavy (1999)"),
notes.align = "l",
covariate.labels = c("Class size", "Percent disadvantaged", "Enrollment", "Enrollment squared / 100"),
column.labels = c("OLS", "OLS", "OLS", "2SLS", "2SLS"))
# Display the results in a well-formatted table
cat("<center>", stargazer_math, "<center>")
# OLS estimations
ols_verb1 <- lm(avgverb ~ verbsize,
na.rm = TRUE, data = final5)
ols_verb2 <- lm(avgverb ~ verbsize + pdis,
na.rm = TRUE, data = final5)
ols_verb3 <- lm(avgverb ~ verbsize + pdis + enroll, data = final5)
# 2SLS estimations
tsls_verb1 <- ivreg(avgverb ~ verbsize + pdis + enroll | m + pdis + enroll,
na.rm = TRUE, data = final5)
tsls_verb2 <- ivreg(avgverb ~ verbsize + pdis + enroll + enoll2percent | m + pdis + enroll + enoll2percent,
na.rm = TRUE, data = final5)
stargazer_verb <- stargazer(ols_verb1, ols_verb2, ols_verb3, tsls_verb1, tsls_verb2,
type = "html",
title = "<center>Effects of Class Size on Fifth Grade Verbal Scores<center>",
label = "tab:class_size_effects_verbal",
digits = 3,
align = TRUE,
style = "AER",
notes = c("Source: Angrist and Lavy (1999)"),
notes.align = "l",
dep.var.labels = "<center>Verbal Scores<center>",
covariate.labels = c("Class size", "Percent disadvantaged", "Enrollment", "Enrollment squared / 100"),
column.labels = c("OLS", "OLS", "OLS", "2SLS", "2SLS"))
# Display the results in a well-formatted table
cat("<center>", stargazer_verb, "<center>")
