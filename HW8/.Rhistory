rural_df <- get(paste0("R", name))
if (is_empty(urban_df) || is_empty(rural_df)) {
cat("Data.frame ", name, " is empty and cannot be processed.\n")
} else {
prepare_and_save_data(name, urban_df, rural_df)
}
}
# Function to load processed data
load_processed_data <- function(file_path) {
readRDS(file_path)
}
# List of dataset suffixes
dataset_suffixes_97 <- c("97P1", "97P3S01", "97P3S02", "97Data", "97P3S03", "97P3S04", "97P3S05",
"97P3S06", "97P3S07", "97P3S08", "97P3S09", "97P3S11", "97P3S12",
"97P4S01", "97P4S02", "97P4S03", "97P4S04")
# Initialize lists to store dataframes and their names
data_list <- list()
dataset_names <- list()
# Loop through each suffix and load the corresponding RDS file
for (suffix in dataset_suffixes) {
file_path <- paste0("./export/Data", suffix, ".RDS")
dataset_name <- paste0("data_", suffix)
data_list[[suffix]] <- load_processed_data(file_path)
dataset_names[[suffix]] <- dataset_name
}
